{
  "name": "svasthnexis-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Unified Healthcare Management Ecosystem Monorepo",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "lint": "npm run --workspaces --if-present lint",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --dir tests/unit",
    "test:integration": "vitest run --dir tests/integration",
    "test:concurrency": "vitest run --dir tests/concurrency",
    "test:security": "vitest run --dir tests/security",
    "test:all": "vitest run",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "clean": "rm -rf dist node_modules packages/*/dist packages/*/node_modules apps/*/dist apps/*/node_modules",
    "seed": "tsx packages/test-fixtures/src/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
