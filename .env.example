# Environment Configuration Template
# Unified Healthcare Management Ecosystem (SvasthNexis)
# NOTE: Never commit live credentials or production secrets to source control.

NODE_ENV=development
PORT=3000
API_PORT=4000
LOG_LEVEL=info

# Database Configuration (PostgreSQL source of truth)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/svasthnexis_dev?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis Cache & Coordination (Slot holds, rate limits, queues)
REDIS_URL=redis://localhost:6379/0

# Object Storage (S3-compatible private encrypted storage)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=ap-south-1
STORAGE_BUCKET=svasthnexis-records-dev
STORAGE_ACCESS_KEY=minio_admin
STORAGE_SECRET_KEY=minio_secret_key_dev
STORAGE_USE_SSL=false

# Authentication & Identity (OIDC compatible)
JWT_SECRET=dev-jwt-secret-do-not-use-in-production-change-me-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
MFA_ISSUER=SvasthNexis-Dev

# Encryption Keys (AES-256-GCM for records at rest & sensitive audit fields)
RECORD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Platform Governance
MAX_PLATFORM_ADMINS=5
ADMIN_REMOVAL_COOLING_OFF_DAYS=7

# Partner Integrations (Adapter mode: sandbox | live)
# In development, use 'sandbox' mode. Never claim live integration without contracts and credentials.
PAYMENT_ADAPTER_MODE=sandbox
PAYMENT_GATEWAY_WEBHOOK_SECRET=sandbox_webhook_secret_placeholder
VIDEO_ADAPTER_MODE=sandbox
SMS_ADAPTER_MODE=sandbox
ABDM_ADAPTER_MODE=sandbox

# Feature Flags for Clinical and Advanced Modules (Defaulted to false/pilot-restricted)
FEATURE_FLAG_INPATIENT=false
FEATURE_FLAG_OT_SURGERY=false
FEATURE_FLAG_BLOOD_BANK=false
FEATURE_FLAG_AI_ASSISTANCE=false
FEATURE_FLAG_ABDM_SYNC=false
